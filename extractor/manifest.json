{
  "manifest_version": 3,
  "name": "Unfollowing Extractor",
  "version": "1.1.0",
  "description": "Extrae tus seguidores y seguidos de Instagram a un snapshot JSON para el dashboard Unfollowing. Usa tu propia sesión, todo local.",
  "permissions": ["scripting", "tabs", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unfollowing Extractor"
  }
}
